+package xiaomi
+
+import (
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Adapted from the round-two independent audit. The stop barrier is the new linearization
+// point: a new session's move must never reach the motor before an old session's stop.
+
+type wireMotor struct {
+	model string
+	mu    sync.Mutex
+	ops   []int
+}
+
+func (w *wireMotor) Model() string { return w.model }
+func (w *wireMotor) Motor(op int) error {
+	w.mu.Lock()
+	w.ops = append(w.ops, op)
+	w.mu.Unlock()
+	return nil
+}
+
+func (w *wireMotor) snapshot() []int {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return append([]int(nil), w.ops...)
+}
+
+func TestRound2Repro1_OldStopDoesNotKillNewSessionMove(t *testing.T) {
+	motor := &wireMotor{model: "xiaomi.camera.c01a01"}
+	withPTZFixture(t, nil, ptzDefaultTiming)
+	lookupMotor = func(string) (motorControl, error) { return motor, nil }
+	now := time.Unix(30000, 0)
+
+	s1, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, s1, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+
+	stream := ptz.streams["cam"]
+	stream.motorLock.Lock()
+
+	stopDone := make(chan struct{})
+	go func() {
+		_, _, _ = ptz.stop("cam", ptz.epoch, s1)
+		close(stopDone)
+	}()
+
+	// Wait until stop(s1) marked the session ended and set the barrier.
+	for {
+		ptz.mu.Lock()
+		ended := stream.current != nil && stream.current.ended
+		barrier := stream.stopBarrier
+		ptz.mu.Unlock()
+		if ended && barrier != nil {
+			break
+		}
+		runtime.Gosched()
+	}
+
+	s2, _, err := ptz.begin("cam", now.Add(10*time.Millisecond))
+	if err != nil {
+		stream.motorLock.Unlock()
+		t.Fatal(err)
+	}
+
+	stream.motorLock.Unlock()
+	if _, err := ptz.move("cam", ptz.epoch, s2, 1, "right", now.Add(10*time.Millisecond)); err != nil {
+		t.Fatalf("move(s2) failed: %v", err)
+	}
+	<-stopDone
+
+	ops := motor.snapshot()
+	if len(ops) < 3 || ops[len(ops)-1] != 2 {
+		t.Fatalf("old stop overtook the new move: %v", ops)
+	}
+	for i, op := range ops {
+		if op == -1001 && i == len(ops)-1 {
+			t.Fatalf("stop was the last command: %v", ops)
+		}
+	}
+}
+
+func TestRound2Repro2_UnmovedBeginExpiresWithoutMotor(t *testing.T) {
+	motor := &wireMotor{model: "xiaomi.camera.c01a01"}
+	timing := ptzTiming{Step: 10 * time.Millisecond, Lease: 20 * time.Millisecond, Cap: 40 * time.Millisecond, Tick: 5 * time.Millisecond}
+	withPTZFixture(t, nil, timing)
+	lookupMotor = func(string) (motorControl, error) { return motor, nil }
+	now := time.Unix(31000, 0)
+
+	session, mode, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if mode != ptzContinuous {
+		t.Fatalf("mode %v", mode)
+	}
+	ptz.tick(now.Add(timing.Lease + time.Millisecond))
+
+	ptz.mu.Lock()
+	current := ptz.streams["cam"].current
+	ended := current != nil && current.session == session && current.ended
+	ptz.mu.Unlock()
+	if !ended {
+		t.Fatal("an unmoved begin session did not expire")
+	}
+	if len(motor.snapshot()) != 0 {
+		t.Fatalf("an unmoved begin touched the motor: %v", motor.snapshot())
+	}
+}
