+type fakeMotor struct {
+	model string
+	mu    sync.Mutex
+	ops   []int
+	calls []int
+	fail  map[int]bool
+}
+
+func (f *fakeMotor) Motor(operation int) error {
+	f.mu.Lock()
+	f.calls = append(f.calls, operation)
+	failing := f.fail[operation]
+	f.mu.Unlock()
+	if failing {
+		return errors.New("write failed")
+	}
+	f.mu.Lock()
+	f.ops = append(f.ops, operation)
+	f.mu.Unlock()
+	return nil
+}
+
+func (f *fakeMotor) Model() string { return f.model }
+
+func (f *fakeMotor) snapshot() []int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]int(nil), f.ops...)
+}
+
+// callSnapshot includes writes the fake rejected, so a test can tell a cached failure from a
+// new attempt to move the motor.
+func (f *fakeMotor) callSnapshot() []int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]int(nil), f.calls...)
+}
+
+func (f *fakeMotor) setFail(operation int, fail bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.fail == nil {
+		f.fail = map[int]bool{}
+	}
+	f.fail[operation] = fail
