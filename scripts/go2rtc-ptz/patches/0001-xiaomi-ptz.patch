+func TestStopIsTheLastMotorCommand(t *testing.T) {
+	motor := &blockingMotor{
+		model:   "xiaomi.camera.c01a01",
+		started: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+	withPTZFixture(t, nil, ptzDefaultTiming)
+	lookupMotor = func(string) (motorControl, error) { return motor, nil }
+	now := time.Unix(14000, 0)
+
+	session, _, _ := ptz.begin("cam", now)
+	moveDone := make(chan error, 1)
+	go func() {
+		_, err := ptz.move("cam", ptz.epoch, session, 1, "left", now)
+		moveDone <- err
+	}()
+	<-motor.started
+
+	stopDone := make(chan struct{})
+	go func() {
+		_, _, _ = ptz.stop("cam", ptz.epoch, session)
+		close(stopDone)
+	}()
+	close(motor.release)
+	<-moveDone
+	<-stopDone
+
+	motor.mu.Lock()
+	ops := append([]int(nil), motor.ops...)
+	motor.mu.Unlock()
+	if len(ops) == 0 || ops[len(ops)-1] != -1001 {
