+func readonlyStream(w http.ResponseWriter, r *http.Request) {
+	id := r.URL.Query().Get("id")
+	if len(id) != 32 || strings.ContainsFunc(id, func(c rune) bool {
+		return !strings.ContainsRune("0123456789abcdef", c)
+	}) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	raw, jpeg := "cam_raw_genericcamera"+id, "cam_mjpeg_genericcamera"+id
+	switch r.Method {
+	case http.MethodPatch:
+		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 8192))
+		source := string(body)
+		_, options, _ := strings.Cut(source, "#")
+		params := streams.ParseQuery(options)
+		if err != nil || params.Get("menubarmijia-readonly") != "1" ||
+			(!strings.HasPrefix(source, "rtsp://") && !strings.HasPrefix(source, "onvif://") && !strings.HasPrefix(source, "tapo://")) {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if _, err := streams.New(raw, source); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if _, err := streams.New(jpeg, "ffmpeg:"+raw+"#video=mjpeg"); err != nil {
+			streams.Delete(raw)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+	case http.MethodDelete:
+		streams.Delete(jpeg)
+		streams.Delete(raw)
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
