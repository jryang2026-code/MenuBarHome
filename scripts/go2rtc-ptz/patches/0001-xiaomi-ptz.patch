+
+// fakeConn is the smallest Conn that lets the client start and lets a test block a command
+// write the way a lost CS2 acknowledgement does.
+type fakeConn struct {
+	commands chan []byte
+
+	mu       sync.Mutex
+	noWait   [][]byte
+	block    chan struct{}
+	aborted  bool
+	closed   chan struct{}
+	closeOne sync.Once
+}
+
+func newFakeConn() *fakeConn {
+	return &fakeConn{commands: make(chan []byte, 4), closed: make(chan struct{})}
+}
+
+func (f *fakeConn) Protocol() string { return "cs2+udp" }
+func (f *fakeConn) Version() string  { return "CS2" }
+func (f *fakeConn) ReadCommand() (uint32, []byte, error) {
+	select {
+	case data := <-f.commands:
+		return cmdEncoded, data, nil
+	case <-f.closed:
+		return 0, nil, net.ErrClosed
+	}
+}
+func (f *fakeConn) WriteCommand(uint32, []byte) error {
+	if f.block != nil {
+		<-f.block
+	}
+	return nil
+}
+func (f *fakeConn) WriteCommandNoWait(_ uint32, data []byte) error {
+	f.mu.Lock()
+	f.noWait = append(f.noWait, append([]byte(nil), data...))
+	f.mu.Unlock()
+	return nil
+}
+func (f *fakeConn) AbortWaits() {
+	f.mu.Lock()
+	f.aborted = true
+	f.mu.Unlock()
+	if f.block != nil {
+		select {
+		case <-f.block:
+		default:
+			close(f.block)
+		}
+	}
+}
+func (f *fakeConn) ReadPacket() ([]byte, []byte, error) { return nil, nil, net.ErrClosed }
+func (f *fakeConn) WritePacket([]byte, []byte) error    { return nil }
+func (f *fakeConn) RemoteAddr() net.Addr                { return &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)} }
+func (f *fakeConn) SetDeadline(time.Time) error         { return nil }
+func (f *fakeConn) Close() error {
+	f.closeOne.Do(func() { close(f.closed) })
+	return nil
+}
+
+func TestMotorStopTakesPriorityOverBlockedWrite(t *testing.T) {
+	conn := newFakeConn()
+	conn.block = make(chan struct{})
+	client := &Client{Conn: conn, key: make([]byte, 32), model: "test"}
+
+	started := make(chan struct{})
+	go func() {
+		close(started)
+		_ = conn.WriteCommand(cmdEncoded, nil)
+	}()
+	<-started
+
+	begin := time.Now()
+	if err := client.Motor(-1001); err != nil {
+		t.Fatalf("Motor(stop): %v", err)
+	}
+	if elapsed := time.Since(begin); elapsed > 200*time.Millisecond {
+		t.Fatalf("stop waited for the blocked write: %s", elapsed)
+	}
+	conn.mu.Lock()
+	aborted := conn.aborted
+	conn.mu.Unlock()
+	if !aborted {
+		t.Fatal("stop did not abort a blocked command write")
+	}
+}
+
+func TestCommandLoopParsesEncodedMotorResponse(t *testing.T) {
+	conn := newFakeConn()
+	key := make([]byte, 32)
+	client := &Client{Conn: conn, key: key, model: "test"}
+	go client.commandLoop()
+
+	payload := binary.BigEndian.AppendUint32(nil, cmdMotorRes)
+	payload = append(payload, []byte(`{"angle":45,"elevation":37,"ret":0}`+"\x00")...)
+	encoded, err := crypto.Encode(payload, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.commands <- encoded
+
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		state, ok := client.LastMotor()
+		if ok {
+			if state.Angle != 45 || state.Elevation != 37 || state.Ret != 0 {
+				t.Fatalf("parsed %+v", state)
+			}
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("motor response was not parsed")
+		}
+		runtime.Gosched()
+	}
+	_ = conn.Close()
+}
+
+func TestMotorRejectsUnknownOperation(t *testing.T) {
+	client := &Client{Conn: newFakeConn(), key: make([]byte, 32)}
+	if err := client.Motor(9); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+func TestMotorPayloadIsJSONOperation(t *testing.T) {
+	conn := newFakeConn()
+	client := &Client{Conn: conn, key: make([]byte, 32)}
+	if err := client.Motor(2); err != nil {
+		t.Fatal(err)
+	}
+	conn.mu.Lock()
+	defer conn.mu.Unlock()
+	if len(conn.noWait) != 1 {
+		t.Fatalf("writes: %d", len(conn.noWait))
+	}
+	decoded, err := crypto.Decode(conn.noWait[0], client.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if binary.BigEndian.Uint32(decoded) != cmdMotorReq {
+		t.Fatalf("inner command: %x", decoded[:4])
+	}
+	var body struct {
+		Operation int `json:"operation"`
+	}
+	if err := json.Unmarshal(decoded[4:], &body); err != nil {
+		t.Fatal(err)
+	}
+	if body.Operation != 2 {
+		t.Fatalf("operation: %d", body.Operation)
+	}
+}
