+func TestRepeatedStopKeepsTheSameWriteFailure(t *testing.T) {
+	motor := &fakeMotor{model: "xiaomi.camera.c01a01", fail: map[int]bool{-1001: true}}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(17000, 0)
+
+	session, _, _ := ptz.begin("cam", now)
+	if _, err := ptz.move("cam", ptz.epoch, session, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, session); err == nil {
+		t.Fatal("first stop lost the write error")
+	}
+	if got := countOps(motor.callSnapshot(), -1001); got != 1 {
+		t.Fatalf("motor stop calls after the first failure = %d, want 1", got)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, session); err == nil {
+		t.Fatal("repeated stop forgot the write error")
+	}
+	if got := countOps(motor.callSnapshot(), -1001); got != 2 {
+		t.Fatalf("a repeated stop did not re-command the motor: calls = %d, want 2", got)
+	}
+	// A later write may succeed: the next attempt reaches the motor again, not a cached error.
+	motor.setFail(-1001, false)
+	sent, _, err := ptz.stop("cam", ptz.epoch, session)
+	if err != nil || !sent {
+		t.Fatalf("stop after the write recovered: sent=%v err=%v", sent, err)
+	}
+	if got := countOps(motor.callSnapshot(), -1001); got != 3 {
+		t.Fatalf("motor stop calls after recovery = %d, want 3", got)
+	}
+	// The success is cached: another stop on the ended session must not move the motor again.
+	if _, _, err := ptz.stop("cam", ptz.epoch, session); err != nil {
+		t.Fatalf("stop after success: %v", err)
+	}
+	if got := countOps(motor.callSnapshot(), -1001); got != 3 {
+		t.Fatalf("a stop after success moved the motor again: calls = %d, want 3", got)
+	}
