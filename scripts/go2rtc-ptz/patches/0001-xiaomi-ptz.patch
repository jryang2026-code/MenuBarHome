+func (b *blockingMotor) Motor(operation int) error {
+	if operation == 1 {
+		b.once.Do(func() { close(b.started) })
+		<-b.release
+	}
+	b.mu.Lock()
+	b.ops = append(b.ops, operation)
+	b.mu.Unlock()
+	return nil
