+package cs2
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestReadCommandUsesBigEndianAndSkipsUnknownChannels(t *testing.T) {
+	c := &Conn{channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	payload := binary.BigEndian.AppendUint32(nil, 0x1001)
+	payload = append(payload, 0xAA)
+	frame := binary.BigEndian.AppendUint32(nil, uint32(len(payload)))
+	frame = append(frame, payload...)
+	if err := c.channels[0].Push(frame); err != nil {
+		t.Fatal(err)
+	}
+	cmd, data, err := c.ReadCommand()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cmd != 0x1001 {
+		t.Fatalf("command %#x", cmd)
+	}
+	if len(data) != 1 || data[0] != 0xAA {
+		t.Fatalf("payload %x", data)
+	}
+}
+
+func TestWriteCommandNoWaitSendsOneDatagram(t *testing.T) {
+	local, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	peer, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+
+	c := &Conn{Conn: &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)}, channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	if err := c.WriteCommandNoWait(0x1001, []byte{0xAA}); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 64)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	n, _, err := peer.ReadFromUDP(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := marshalCmd(0, 0, 0x1001, []byte{0xAA})
+	if !bytes.Equal(buf[:n], want) {
+		t.Fatalf("frame %x, want %x", buf[:n], want)
+	}
+}
+
+func TestAbortWaitsInterruptsLostAckRetry(t *testing.T) {
+	local, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	peer, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+
+	c := &Conn{Conn: &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)}, channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	done := make(chan error, 1)
+	go func() { done <- c.WriteCommand(0x1001, []byte{1}) }()
+
+	// Wait for the first datagram instead of sleeping; the peer never sends msgDrwAck.
+	buf := make([]byte, 64)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, _, err := peer.ReadFromUDP(buf); err != nil {
+		t.Fatal(err)
+	}
+	begin := time.Now()
+	c.AbortWaits()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected an aborted command error")
+		}
+		if elapsed := time.Since(begin); elapsed > 500*time.Millisecond {
+			t.Fatalf("abort waited for the 1s retry tick: %s", elapsed)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("WriteCommand did not return after AbortWaits")
+	}
+}
+
+func TestCloseSendsMsgCloseBeforeClosingSocket(t *testing.T) {
+	local, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		_ = local.Close()
+		t.Fatal(err)
+	}
+	defer peer.Close()
+
+	c := &Conn{
+		Conn: &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)},
+		channels: [4]*dataChannel{
+			newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+		},
+	}
+
+	if err := c.Close(); err != nil {
+		t.Fatalf("Close returned error: %v", err)
+	}
+
+	buf := make([]byte, 16)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	n, _, err := peer.ReadFromUDP(buf)
+	if err != nil {
+		t.Fatalf("peer did not receive msgClose: %v", err)
+	}
+	want := []byte{magic, msgClose, 0, 0}
+	if !bytes.Equal(buf[:n], want) {
+		t.Fatalf("close frame %x, want %x", buf[:n], want)
+	}
+}
+
+// TestReopenAfterCloseLatencyFixture simulates a single-slot Xiaomi CS2 camera
+// that holds its streaming slot for 20s on silent disconnect, but frees it
+// immediately upon receiving msgClose. Reopening right after Close must finish
+// well below the camera's 20s slot timeout.
+func TestReopenAfterCloseLatencyFixture(t *testing.T) {
+	camera, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer camera.Close()
+
+	const slotHoldWithoutClose = 20 * time.Second
+	done := make(chan struct{})
+	defer close(done)
+
+	go func() {
+		var activeAddr string
+		var slotFreeAt time.Time
+		buf := make([]byte, 256)
+		for {
+			_ = camera.SetReadDeadline(time.Now().Add(100 * time.Millisecond))
+			n, addr, err := camera.ReadFromUDP(buf)
+			if err != nil {
+				select {
+				case <-done:
+					return
+				default:
+					continue
+				}
+			}
+			if n < 2 || buf[0] != magic {
+				continue
+			}
+			now := time.Now()
+			if activeAddr != "" && now.After(slotFreeAt) {
+				activeAddr = ""
+			}
+			switch buf[1] {
+			case msgLanSearch:
+				if activeAddr != "" && activeAddr != addr.String() {
+					continue
+				}
+				pkt := make([]byte, 20)
+				pkt[0] = magic
+				pkt[1] = msgPunchPkt
+				pkt[3] = 16
+				_, _ = camera.WriteToUDP(pkt, addr)
+			case msgPunchPkt:
+				if activeAddr != "" && activeAddr != addr.String() {
+					continue
+				}
+				activeAddr = addr.String()
+				slotFreeAt = now.Add(slotHoldWithoutClose)
+				pkt := make([]byte, 20)
+				pkt[0] = magic
+				pkt[1] = msgP2PRdyUDP
+				pkt[3] = 16
+				_, _ = camera.WriteToUDP(pkt, addr)
+			case msgClose:
+				if activeAddr == addr.String() {
+					activeAddr = ""
+					slotFreeAt = time.Time{}
+				}
+			}
+		}
+	}()
+
+	host := camera.LocalAddr().String()
+	first, err := Dial(host, "udp")
+	if err != nil {
+		t.Fatalf("first Dial failed: %v", err)
+	}
+	if err := first.Close(); err != nil {
+		t.Fatalf("first Close failed: %v", err)
+	}
+
+	reopenStart := time.Now()
+	second, err := Dial(host, "udp")
+	if err != nil {
+		t.Fatalf("reopen Dial failed after Close: %v", err)
+	}
+	reopenElapsed := time.Since(reopenStart)
+	_ = second.Close()
+
+	if reopenElapsed > 500*time.Millisecond {
+		t.Fatalf("reopen-after-close latency %s exceeded 500ms budget", reopenElapsed)
+	}
+}
