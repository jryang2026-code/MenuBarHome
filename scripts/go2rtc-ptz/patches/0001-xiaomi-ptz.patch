+package cs2
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestReadCommandUsesBigEndianAndSkipsUnknownChannels(t *testing.T) {
+	c := &Conn{channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	payload := binary.BigEndian.AppendUint32(nil, 0x1001)
+	payload = append(payload, 0xAA)
+	frame := binary.BigEndian.AppendUint32(nil, uint32(len(payload)))
+	frame = append(frame, payload...)
+	if err := c.channels[0].Push(frame); err != nil {
+		t.Fatal(err)
+	}
+	cmd, data, err := c.ReadCommand()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cmd != 0x1001 {
+		t.Fatalf("command %#x", cmd)
+	}
+	if len(data) != 1 || data[0] != 0xAA {
+		t.Fatalf("payload %x", data)
+	}
+}
+
+func TestWriteCommandNoWaitSendsOneDatagram(t *testing.T) {
+	local, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	peer, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+
+	c := &Conn{Conn: &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)}, channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	if err := c.WriteCommandNoWait(0x1001, []byte{0xAA}); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 64)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	n, _, err := peer.ReadFromUDP(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := marshalCmd(0, 0, 0x1001, []byte{0xAA})
+	if !bytes.Equal(buf[:n], want) {
+		t.Fatalf("frame %x, want %x", buf[:n], want)
+	}
+}
+
+func TestAbortWaitsInterruptsLostAckRetry(t *testing.T) {
+	local, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	peer, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+
+	c := &Conn{Conn: &udpConn{UDPConn: local, addr: peer.LocalAddr().(*net.UDPAddr)}, channels: [4]*dataChannel{
+		newDataChannel(0, 1), nil, newDataChannel(0, 1), nil,
+	}}
+	done := make(chan error, 1)
+	go func() { done <- c.WriteCommand(0x1001, []byte{1}) }()
+
+	// Wait for the first datagram instead of sleeping; the peer never sends msgDrwAck.
+	buf := make([]byte, 64)
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, _, err := peer.ReadFromUDP(buf); err != nil {
+		t.Fatal(err)
+	}
+	begin := time.Now()
+	c.AbortWaits()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected an aborted command error")
+		}
+		if elapsed := time.Since(begin); elapsed > 500*time.Millisecond {
+			t.Fatalf("abort waited for the 1s retry tick: %s", elapsed)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("WriteCommand did not return after AbortWaits")
+	}
+}
