+func TestStopFormerSessionRejectsMovedEndedSessionAndProtectsNewerStopState(t *testing.T) {
+	motor := &fakeMotor{model: "xiaomi.camera.c01a01", fail: map[int]bool{-1001: true}}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(21000, 0)
+
+	first, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, first, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, first); err == nil {
+		t.Fatal("first stop should fail")
+	}
+
+	motor.model = "chuangmi.camera.029a02"
+	second, _, err := ptz.begin("cam", now.Add(time.Millisecond))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, second, 1, "right", now.Add(time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, second); err != nil {
+		t.Fatal(err)
+	}
+
+	motor.setFail(-1001, false)
+	if _, _, err := ptz.stop("cam", ptz.epoch, first); err == nil {
+		t.Fatal("stopFormerSession retried motor after a newer session had already moved and ended")
+	}
+	if got := countOps(motor.callSnapshot(), -1001); got != 1 {
+		t.Fatalf("stopFormerSession touched motor after newer session moved: calls=%d", got)
+	}
+
+	stream := ptz.streams["cam"]
+	ptz.mu.Lock()
+	stream.lastStopSession = second
+	stream.lastStopMode = ptzContinuous
+	stream.lastStopSent = false
+	stream.lastStopErr = errors.New("second stop failed")
+	ptz.mu.Unlock()
+
+	if sent, _, err := ptz.stop("cam", ptz.epoch, first); err != nil || sent {
+		t.Fatalf("stale stop after newer stop state: sent=%v err=%v", sent, err)
+	}
+	ptz.mu.Lock()
+	gotLastSession := stream.lastStopSession
+	gotLastErr := stream.lastStopErr
+	ptz.mu.Unlock()
+	if gotLastSession != second || gotLastErr == nil {
+		t.Fatalf("stale stop corrupted newer lastStop state: session=%d err=%v", gotLastSession, gotLastErr)
+	}
+}
