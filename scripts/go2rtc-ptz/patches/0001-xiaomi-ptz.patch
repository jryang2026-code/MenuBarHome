+func TestStopAbortsBlockedMoveWithoutTransmittingStaleStep(t *testing.T) {
+	motor := &blockingMotor{
+		model:     "xiaomi.camera.c01a01",
+		started:   make(chan struct{}),
+		release:   make(chan struct{}),
+		abortDrop: true,
+	}
+	withPTZFixture(t, nil, ptzDefaultTiming)
+	lookupMotor = func(string) (motorControl, error) { return motor, nil }
+	now := time.Unix(20000, 0)
+
+	session, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	moveDone := make(chan error, 1)
+	go func() {
+		_, moveErr := ptz.move("cam", ptz.epoch, session, 1, "left", now)
+		moveDone <- moveErr
+	}()
+	<-motor.started
+
+	begin := time.Now()
+	sent, mode, err := ptz.stop("cam", ptz.epoch, session)
+	if err != nil || !sent || mode != ptzContinuous {
+		t.Fatalf("stop: sent=%v mode=%v err=%v", sent, mode, err)
+	}
+	if elapsed := time.Since(begin); elapsed > 200*time.Millisecond {
+		t.Fatalf("stop waited on blocked move: %s", elapsed)
+	}
+	if moveErr := <-moveDone; moveErr == nil {
+		t.Fatal("expected aborted move to return error")
+	}
+
+	motor.mu.Lock()
+	ops := append([]int(nil), motor.ops...)
+	aborted := motor.aborted
+	motor.mu.Unlock()
+	if !aborted {
+		t.Fatal("stop did not call motor.Abort() before locking motorLock")
+	}
+	if len(ops) != 1 || ops[0] != -1001 {
+		t.Fatalf("expected only stop (-1001) without stale move, got %v", ops)
+	}
+}
