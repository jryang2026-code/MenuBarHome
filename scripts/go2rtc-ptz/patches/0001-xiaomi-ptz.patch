+// WriteCommandNoWait sends one command without waiting for the IOCtrl ack. Motor commands must
+// not hold the command lock for the retry window, or a stop would queue behind a lost move.
+func (c *Conn) WriteCommandNoWait(ctrlType uint32, ctrlData []byte) error {
+	c.cmdMu.Lock()
+	defer c.cmdMu.Unlock()
+
+	buf := c.session.SendIOCtrl(ctrlType, ctrlData)
+	return c.session.SessionWrite(0, buf)
+}
+
+// AbortWaits wakes every WriteCommand blocked on its acknowledgement retry.
+func (c *Conn) AbortWaits() {
+	c.abortMu.Lock()
+	if c.abort != nil {
+		close(c.abort)
+	}
+	c.abort = make(chan struct{})
+	c.abortMu.Unlock()
+}
+
+func (c *Conn) abortChan() chan struct{} {
+	c.abortMu.Lock()
+	defer c.abortMu.Unlock()
+	if c.abort == nil {
+		c.abort = make(chan struct{})
+	}
+	return c.abort
+}
