+func TestDafangMotorUsesRawICamCommand(t *testing.T) {
+	cases := []struct {
+		operation int
+		want      []byte
+	}{
+		{1, dafangRaw(0xff2404, 1, 0, 5)},
+		{2, dafangRaw(0xff2404, 2, 0, 5)},
+		{3, dafangRaw(0xff2404, 0, 2, 5)},
+		{4, dafangRaw(0xff2404, 0, 1, 5)},
+		{-1001, dafangRaw(0xff2404, 0, 0, 5)},
+	}
+	for _, tc := range cases {
+		conn := newFakeConn()
+		client := &Client{Conn: conn, key: make([]byte, 32), model: ModelDafang}
+		if err := client.Motor(tc.operation); err != nil {
+			t.Fatalf("operation %d: %v", tc.operation, err)
+		}
+		conn.mu.Lock()
+		writes := append([][]byte(nil), conn.noWait...)
+		conn.mu.Unlock()
+		wantWrites := 1
+		if tc.operation == -1001 {
+			wantWrites = 3 // bounded UDP retries; still no acknowledgement wait
+		}
+		if len(writes) != wantWrites {
+			t.Fatalf("operation %d wrote %d frames, want %d", tc.operation, len(writes), wantWrites)
+		}
+		decoded, err := crypto.Decode(writes[0], client.key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(decoded, tc.want) {
+			t.Fatalf("operation %d payload %x, want %x", tc.operation, decoded, tc.want)
+		}
+	}
