+func (f *fakeConn) Protocol() string { return "cs2+udp" }
+func (f *fakeConn) Version() string  { return "CS2" }
+func (f *fakeConn) ReadCommand() (uint32, []byte, error) {
+	select {
+	case data := <-f.commands:
+		return cmdEncoded, data, nil
+	case <-f.closed:
+		return 0, nil, net.ErrClosed
+	}
+}
+func (f *fakeConn) abortChan() chan struct{} {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.abort == nil {
+		f.abort = make(chan struct{})
+	}
+	return f.abort
+}
+func (f *fakeConn) WriteCommand(_ uint32, data []byte) error {
+	f.cmdMu.Lock()
+	defer f.cmdMu.Unlock()
+	f.mu.Lock()
+	f.cmds = append(f.cmds, append([]byte(nil), data...))
+	block := f.block
+	blockedCh := f.blockedCh
+	f.mu.Unlock()
+	if blockedCh != nil {
+		f.blockOnce.Do(func() { close(blockedCh) })
+	}
+	if block != nil {
+		abort := f.abortChan()
+		select {
+		case <-block:
+		case <-abort:
+			return errors.New("command aborted")
+		}
+	}
+	return nil
+}
+func (f *fakeConn) WriteCommandNoWait(_ uint32, data []byte) error {
+	abort := f.abortChan()
+	f.cmdMu.Lock()
+	defer f.cmdMu.Unlock()
+	select {
+	case <-abort:
+		return errors.New("no-wait command aborted")
+	default:
+	}
+	f.mu.Lock()
+	f.noWait = append(f.noWait, append([]byte(nil), data...))
+	f.mu.Unlock()
+	return nil
+}
+func (f *fakeConn) AbortWaits() {
+	f.mu.Lock()
+	f.aborted = true
+	if f.abort != nil {
+		close(f.abort)
+	}
+	f.abort = make(chan struct{})
+	block := f.block
+	f.mu.Unlock()
+	if block != nil {
+		select {
+		case <-block:
+		default:
+			close(block)
+		}
+	}
+}
+func (f *fakeConn) ReadPacket() ([]byte, []byte, error) { return nil, nil, net.ErrClosed }
+func (f *fakeConn) WritePacket([]byte, []byte) error    { return nil }
+func (f *fakeConn) RemoteAddr() net.Addr                { return &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)} }
+func (f *fakeConn) SetDeadline(time.Time) error         { return nil }
+func (f *fakeConn) Close() error {
+	f.closeOne.Do(func() { close(f.closed) })
+	return nil
+}
