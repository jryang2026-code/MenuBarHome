+	}
+	if countOps(motor.snapshot(), 1) != 1 {
+		t.Fatalf("first step missing: %v", motor.snapshot())
+	}
+	ptz.tick(now.Add(timing.Step + time.Millisecond))
+	if countOps(motor.snapshot(), 1) != 2 {
+		t.Fatalf("step not repeated: %v", motor.snapshot())
+	}
+	ptz.tick(now.Add(timing.Step + timing.Step + time.Millisecond))
