+func TestPTZEndpointRejectsUnsafeRequests(t *testing.T) {
+	motor := &fakeMotor{model: "chuangmi.camera.029a02"}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+
+	call := func(method, remote, origin, body string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(method, "/api/xiaomi/ptz", strings.NewReader(body))
+		req.RemoteAddr = remote
+		if origin != "" {
+			req.Header.Set("Origin", origin)
+		}
+		rec := httptest.NewRecorder()
+		apiPTZ(rec, req)
+		return rec
+	}
+
+	if rec := call("GET", "127.0.0.1:1234", "", ""); rec.Code != http.StatusMethodNotAllowed ||
+		rec.Header().Get("X-MenuBarMijia-PTZ") != "v1" {
+		t.Fatalf("GET: %d header=%q", rec.Code, rec.Header().Get("X-MenuBarMijia-PTZ"))
+	}
+	if rec := call("POST", "192.0.2.10:1234", "", `{"src":"cam","action":"begin"}`); rec.Code != http.StatusForbidden {
+		t.Fatalf("non-loopback: %d", rec.Code)
+	}
+	if rec := call("POST", "127.0.0.1:1234", "https://evil.example", `{"src":"cam","action":"begin"}`); rec.Code != http.StatusForbidden {
+		t.Fatalf("origin: %d", rec.Code)
+	}
+	if rec := call("POST", "127.0.0.1:1234", "", `{"src":"cam","action":"teleport"}`); rec.Code != http.StatusBadRequest {
+		t.Fatalf("bad action: %d", rec.Code)
+	}
+	rec := call("POST", "127.0.0.1:1234", "", `{"src":"cam","action":"begin"}`)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("begin: %d %s", rec.Code, rec.Body.String())
+	}
+	var beginReply struct {
+		Epoch   string `json:"epoch"`
+		Session uint64 `json:"session"`
+		Mode    string `json:"mode"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &beginReply); err != nil {
+		t.Fatal(err)
+	}
+	if beginReply.Epoch == "" || beginReply.Session == 0 || beginReply.Mode != "step" {
+		t.Fatalf("begin reply: %s", rec.Body.String())
+	}
+	rec = call("POST", "127.0.0.1:1234", "", `{"src":"cam","action":"stop","epoch":"`+beginReply.Epoch+`","session":`+itoa(beginReply.Session)+`}`)
+	if rec.Code != http.StatusOK {
