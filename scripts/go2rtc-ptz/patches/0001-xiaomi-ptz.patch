+	client := &Client{Conn: conn, key: make([]byte, 32), model: "mxiang.camera.mwc10", subDID: subDID}
+
+	if err := client.StartMedia("", "", `1,"injected":true`); err != nil {
+		t.Fatalf("StartMedia: %v", err)
+	}
+	if err := client.StopMedia(); err != nil {
+		t.Fatalf("StopMedia: %v", err)
+	}
+
+	conn.mu.Lock()
+	cmds := append([][]byte(nil), conn.cmds...)
+	conn.mu.Unlock()
+	if len(cmds) != 2 {
+		t.Fatalf("expected 2 commands, got %d", len(cmds))
+	}
+
+	startDec, err := crypto.Decode(cmds[0], client.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := binary.BigEndian.Uint32(startDec); got != cmdVideoStart {
+		t.Fatalf("start cmd = %#x, want %#x", got, cmdVideoStart)
+	}
+	var startPayload map[string]any
+	if err := json.Unmarshal(startDec[4:], &startPayload); err != nil {
+		t.Fatalf("start JSON invalid: %v (%s)", err, startDec[4:])
+	}
+	if startPayload["subdid"] != subDID || startPayload["enableaudio"] != float64(1) || len(startPayload) != 2 {
+		t.Fatalf("unexpected start payload: %#v", startPayload)
+	}
+
+	stopDec, err := crypto.Decode(cmds[1], client.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := binary.BigEndian.Uint32(stopDec); got != cmdVideoStop {
+		t.Fatalf("stop cmd = %#x, want %#x", got, cmdVideoStop)
+	}
+	var stopPayload map[string]any
+	if err := json.Unmarshal(stopDec[4:], &stopPayload); err != nil {
+		t.Fatalf("stop JSON invalid: %v (%s)", err, stopDec[4:])
+	}
+	if stopPayload["subdid"] != subDID || stopPayload["enableaudio"] != float64(0) || stopPayload["videoquality"] != float64(0) || len(stopPayload) != 3 {
+		t.Fatalf("unexpected stop payload: %#v", stopPayload)
+	}
+}
