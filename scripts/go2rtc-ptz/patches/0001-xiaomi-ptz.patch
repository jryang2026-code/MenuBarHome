+func TestMotorStopTakesPriorityOverBlockedWrite(t *testing.T) {
+	conn := newFakeConn()
+	conn.block = make(chan struct{})
+	conn.blockedCh = make(chan struct{})
+	client := &Client{Conn: conn, key: make([]byte, 32), model: "test"}
+
+	writeDone := make(chan error, 1)
+	go func() {
+		writeDone <- conn.WriteCommand(cmdEncoded, nil)
+	}()
+	<-conn.blockedCh
+
+	moveDone := make(chan error, 1)
+	go func() {
+		moveDone <- client.Motor(1)
+	}()
+	time.Sleep(10 * time.Millisecond)
+
+	begin := time.Now()
+	if err := client.Motor(-1001); err != nil {
+		t.Fatalf("Motor(stop): %v", err)
+	}
+	if elapsed := time.Since(begin); elapsed > 250*time.Millisecond {
+		t.Fatalf("stop waited for the blocked write: %s", elapsed)
+	}
+	if err := <-writeDone; err == nil {
+		t.Fatal("expected blocked WriteCommand to abort")
+	}
+	if err := <-moveDone; err == nil {
+		t.Fatal("expected queued move to abort instead of transmitting after stop")
+	}
+	conn.mu.Lock()
+	aborted := conn.aborted
+	writes := append([][]byte(nil), conn.noWait...)
+	conn.mu.Unlock()
+	if !aborted {
+		t.Fatal("stop did not abort a blocked command write")
+	}
+	if len(writes) != 3 {
+		t.Fatalf("expected 3 stop frames and 0 stale move frames, got %d", len(writes))
+	}
+	for i, raw := range writes {
+		decoded, err := crypto.Decode(raw, client.key)
+		if err != nil {
+			t.Fatalf("frame %d decode: %v", i, err)
+		}
+		var body struct {
+			Operation int `json:"operation"`
+		}
+		if err := json.Unmarshal(decoded[4:], &body); err != nil {
+			t.Fatalf("frame %d unmarshal: %v", i, err)
+		}
+		if body.Operation != -1001 {
+			t.Fatalf("frame %d operation = %d, want -1001", i, body.Operation)
+		}
+	}
+}
