+func dialLoopbackCS2ForProducerTest(t *testing.T) (*cs2.Conn, *net.UDPConn, <-chan []byte) {
+	t.Helper()
+	camera, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = camera.Close() })
+
+	closeReceived := make(chan []byte, 4)
+	done := make(chan struct{})
+	t.Cleanup(func() { close(done) })
+
+	go func() {
+		buf := make([]byte, 256)
+		for {
+			_ = camera.SetReadDeadline(time.Now().Add(50 * time.Millisecond))
+			n, addr, err := camera.ReadFromUDP(buf)
+			if err != nil {
+				select {
+				case <-done:
+					return
+				default:
+					continue
+				}
+			}
+			if n < 2 || buf[0] != 0xF1 {
+				continue
+			}
+			switch buf[1] {
+			case 0x30: // msgLanSearch
+				pkt := make([]byte, 20)
+				pkt[0] = 0xF1
+				pkt[1] = 0x41
+				pkt[3] = 16
+				_, _ = camera.WriteToUDP(pkt, addr)
+			case 0x41: // msgPunchPkt
+				pkt := make([]byte, 20)
+				pkt[0] = 0xF1
+				pkt[1] = 0x42
+				pkt[3] = 16
+				_, _ = camera.WriteToUDP(pkt, addr)
+			case 0xD0: // msgDrw (e.g. cmdVideoStop) - ACK so StopMedia returns immediately
+				if n >= 8 {
+					_, _ = camera.WriteToUDP([]byte{0xF1, 0xD1, 0, 6, 0xD1, buf[5], 0, 1, buf[6], buf[7]}, addr)
+				}
+			case 0xF0: // msgClose
+				frame := append([]byte(nil), buf[:n]...)
+				select {
+				case closeReceived <- frame:
+				default:
+				}
+			}
+		}
+	}()
+
+	conn, err := cs2.Dial(camera.LocalAddr().String(), "udp")
+	if err != nil {
+		t.Fatalf("cs2.Dial failed: %v", err)
+	}
+	return conn, camera, closeReceived
+}
+
+func TestProducerStopSendsMsgClose(t *testing.T) {
+	conn, _, closeReceived := dialLoopbackCS2ForProducerTest(t)
+	client := &Client{Conn: conn, key: make([]byte, 16)}
+	producer := &Producer{
+		Connection: core.Connection{Transport: client},
+		client:     client,
+	}
+
+	if err := producer.Stop(); err != nil {
+		t.Fatalf("Producer.Stop returned error: %v", err)
+	}
+
+	select {
+	case frame := <-closeReceived:
+		want := []byte{0xF1, 0xF0, 0, 0}
+		if !bytes.Equal(frame, want) {
+			t.Fatalf("close frame %x, want %x", frame, want)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for msgClose on Producer.Stop")
+	}
+}
+
+func TestProducerStartCancellationSendsMsgClose(t *testing.T) {
+	conn, _, closeReceived := dialLoopbackCS2ForProducerTest(t)
+	client := &Client{Conn: conn, key: make([]byte, 16)}
+	producer := &Producer{
+		Connection: core.Connection{Transport: client},
+		client:     client,
+	}
+
+	// Simulate stream cancellation by closing the read channel / underlying conn
+	// while Start() is waiting for the next packet. Start() must close the client
+	// immediately so msgClose is sent before returning.
+	startErr := make(chan error, 1)
+	go func() {
+		startErr <- producer.Start()
+	}()
+
+	// Wait briefly for Start() to set its initial 10s read deadline and enter ReadPacket,
+	// then shorten the read deadline to simulate stream cancellation / timeout.
+	time.Sleep(30 * time.Millisecond)
+	_ = conn.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+
+	select {
+	case err := <-startErr:
+		if err == nil {
+			t.Fatal("expected Producer.Start to return read error")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Producer.Start did not exit after deadline cancellation")
+	}
+
+	select {
+	case frame := <-closeReceived:
+		want := []byte{0xF1, 0xF0, 0, 0}
+		if !bytes.Equal(frame, want) {
+			t.Fatalf("close frame %x, want %x", frame, want)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for msgClose after Producer.Start error")
+	}
+}
