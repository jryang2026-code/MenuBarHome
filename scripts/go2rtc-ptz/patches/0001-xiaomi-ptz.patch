index 0000000..3ffd76c
--- /dev/null
+++ b/internal/xiaomi/audit_repro_test.go
@@ -0,0 +1,108 @@
+package xiaomi
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+// Adapted from the independent audit reproduction. The API now allocates a bridge session, so
+// "stop before move" means begin -> stop -> late move. Assertions are the original ones: the
+// motor must never start, and no stop may claim a successful write when the write failed.
+
+func TestAuditRepro1A_StopBeforeFirstMoveFailsToBlockLateMove(t *testing.T) {
+	motor := &fakeMotor{model: "xiaomi.camera.c01a01"}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(20000, 0)
+
+	session, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sent, mode, err := ptz.stop("cam", ptz.epoch, session)
+	t.Logf("stop before move: sent=%v mode=%v err=%v", sent, mode, err)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, session, 1, "left", now.Add(time.Millisecond)); !errors.Is(err, errPTZEnded) {
+		t.Fatalf("BUG (1A): late move after stop started the motor: ops=%v err=%v", motor.snapshot(), err)
+	}
+	if len(motor.snapshot()) != 0 {
+		t.Fatalf("BUG (1A): an unmoved begin touched the motor: %v", motor.snapshot())
+	}
+}
+
+func TestAuditRepro1B_StopBeforeFirstMoveAfterPreviousSessionReturnsConflict(t *testing.T) {
+	motor := &fakeMotor{model: "xiaomi.camera.c01a01"}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(21000, 0)
+
+	old, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, old, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, old); err != nil {
+		t.Fatal(err)
+	}
+
+	fresh, _, err := ptz.begin("cam", now.Add(time.Second))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, fresh); err != nil {
+		t.Fatalf("BUG (1B): stop before move failed: %v", err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, fresh, 1, "left", now.Add(time.Second+time.Millisecond)); !errors.Is(err, errPTZEnded) {
+		t.Fatalf("BUG (1B-followup): late move started: %v", err)
+	}
+}
+
+func TestAuditRepro2_OldGenerationResurrectsAfterNewerGenerationEnds(t *testing.T) {
+	motor := &fakeMotor{model: "xiaomi.camera.c01a01"}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(22000, 0)
+
+	first, _, _ := ptz.begin("cam", now)
+	if _, err := ptz.move("cam", ptz.epoch, first, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, first); err != nil {
+		t.Fatal(err)
+	}
+
+	second, _, _ := ptz.begin("cam", now.Add(time.Second))
+	if _, err := ptz.move("cam", ptz.epoch, second, 1, "right", now.Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ptz.stop("cam", ptz.epoch, second); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := ptz.move("cam", ptz.epoch, first, 2, "left", now.Add(2*time.Second)); !errors.Is(err, errPTZEnded) && !errors.Is(err, errPTZNoSession) {
+		t.Fatalf("BUG (2): old generation revived: %v", err)
+	}
+}
+
+func TestAuditRepro3_StopSwallowsMotorWriteErrorAndClaimsSent(t *testing.T) {
+	motor := &fakeMotor{
+		model: "xiaomi.camera.c01a01",
+		fail:  map[int]bool{-1001: true},
+	}
+	withPTZFixture(t, motor, ptzDefaultTiming)
+	now := time.Unix(23000, 0)
+
+	session, _, err := ptz.begin("cam", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ptz.move("cam", ptz.epoch, session, 1, "left", now); err != nil {
+		t.Fatal(err)
+	}
+	sent, _, err := ptz.stop("cam", ptz.epoch, session)
+	if err == nil || sent {
+		t.Fatalf("BUG (3): stop swallowed the write error: sent=%v err=%v", sent, err)
+	}
+}
diff --git a/internal/xiaomi/ptz.go b/internal/xiaomi/ptz.go
new file mode 100644
index 0000000..e1479c2
--- /dev/null
+++ b/internal/xiaomi/ptz.go
@@ -0,0 +1,639 @@
+package xiaomi
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/internal/streams"
+)
+
+// Timing for a held drag. The client renews a move every heartbeat; a move that is no longer
+// renewed stops on the bridge even when the app crashed or its network went away.
+type ptzTiming struct {
+	Step  time.Duration
+	Lease time.Duration
+	Cap   time.Duration
+	Tick  time.Duration
+}
+
+var ptzDefaultTiming = ptzTiming{
+	Step:  380 * time.Millisecond,
+	Lease: 700 * time.Millisecond,
+	Cap:   8 * time.Second,
+	Tick:  100 * time.Millisecond,
+}
+
+type ptzMode int
+
+const (
+	ptzStep ptzMode = iota
+	ptzContinuous
+	ptzUnknown
+)
+
+func (m ptzMode) String() string {
+	switch m {
+	case ptzStep:
+		return "step"
+	case ptzContinuous:
+		return "continuous"
+	default:
+		return "unknown"
+	}
+}
+
+// ptzProfiles is an evidence table, not a brand rule. Step/continuous entries come from
+// real-device reports; a model outside the table keeps the plain viewer.
+var ptzProfiles = map[string]ptzMode{
+	// One operation moves a bounded step and self-stops.
+	"chuangmi.camera.029a02": ptzStep,
+	"isa.camera.hlc8":        ptzStep,
+	"isa.camera.hlc8a":       ptzStep,
+	"isa.camera.500dh":       ptzStep,
+	"isa.camera.hlmax":       ptzStep,
+
+	// One operation runs until -1001.
+	"xiaomi.camera.c01a01":   ptzContinuous,
+	"chuangmi.camera.72ac1":  ptzContinuous,
+	"chuangmi.camera.039a04": ptzContinuous,
+	"chuangmi.camera.039c04": ptzContinuous,
+	"isa.camera.df3":         ptzContinuous,
+	"isa.camera.isc5c1":      ptzContinuous,
+
+	// Hardware is documented; the motor's motion mode has not been verified on a real unit.
+	"chuangmi.camera.061a01": ptzUnknown,
+	"chuangmi.camera.061a03": ptzUnknown,
+	"chuangmi.camera.069a01": ptzUnknown,
+	"chuangmi.camera.039c01": ptzUnknown,
+	"chuangmi.camera.021a04": ptzUnknown,
+	"chuangmi.camera.026c02": ptzUnknown,
+	"chuangmi.camera.ipc019": ptzUnknown,
+	"chuangmi.camera.ip029a": ptzUnknown,
+}
+
+type motorControl interface {
+	Motor(operation int) error
+	Model() string
+}
+
+// A session is allocated by this bridge. Sessions are monotonic per stream and stoppedThrough is
+// a permanent high-water mark, so a late packet from an old session can never start a motor.
+type ptzSession struct {
+	session   uint64
+	lastSeq   uint64
+	direction string
+	mode      ptzMode
+	motor     motorControl
+	started   time.Time
+	expires   time.Time
+	lastStep  time.Time
+	created   time.Time
+	ended     bool
+	stopDone  chan struct{}
+	cancel    context.CancelFunc
+}
+
+type ptzStream struct {
+	motorLock       sync.Mutex
+	stopMu          sync.Mutex
+	nextSession     uint64
+	stoppedThrough  uint64
+	lastStopSession uint64
+	lastStopSent    bool
+	lastStopErr     error
+	stopsInFlight   int
+	stopBarrier     chan struct{}
+	current         *ptzSession
+}
+
+type ptzManager struct {
+	mu      sync.Mutex
+	streams map[string]*ptzStream
+	timing  ptzTiming
+	epoch   string
+	autoRun bool
+}
+
+func newPTZManager() *ptzManager {
+	var raw [8]byte
+	_, _ = rand.Read(raw[:])
+	return &ptzManager{
+		streams: map[string]*ptzStream{},
+		timing:  ptzDefaultTiming,
+		epoch:   hex.EncodeToString(raw[:]),
+		autoRun: true,
+	}
+}
+
+var ptz = newPTZManager()
+
+var (
+	errPTZConflict    = errors.New("another move is active")
+	errPTZEnded       = errors.New("move already ended")
+	errPTZStale       = errors.New("stale command")
+	errPTZNoSession   = errors.New("no such session")
+	errPTZUnsupported = errors.New("camera is not a known PTZ model")
+	errPTZNoMotor     = errors.New("stream has no connected motor")
+	errPTZEpoch       = errors.New("bridge epoch changed")
+	errPTZStopWrite   = errors.New("stop write failed")
+)
+
+func directionOperation(direction string) (int, bool) {
+	switch direction {
+	case "left":
+		return 1, true
+	case "right":
+		return 2, true
+	case "up":
+		return 3, true
+	case "down":
+		return 4, true
+	}
+	return 0, false
+}
+
+var lookupMotor = findMotor
+
+func findMotor(name string) (motorControl, error) {
+	stream := streams.Get(name)
+	if stream == nil {
+		return nil, fmt.Errorf("stream %q not found", name)
+	}
+	isXiaomi := false
+	for _, src := range stream.Sources() {
+		if strings.HasPrefix(src, "xiaomi:") {
+			isXiaomi = true
+			break
+		}
+	}
+	if !isXiaomi {
+		return nil, errPTZNoMotor
+	}
+	for _, conn := range stream.Conns() {
+		if motor, ok := conn.(motorControl); ok {
+			return motor, nil
+		}
+	}
+	return nil, errPTZNoMotor
+}
+
+// begin allocates one session per drag. It never touches a motor; the first move does.
+func (m *ptzManager) begin(name string, now time.Time) (uint64, ptzMode, error) {
+	motor, err := lookupMotor(name)
+	if err != nil {
+		return 0, 0, err
+	}
+	mode, ok := ptzProfiles[motor.Model()]
+	if !ok {
+		return 0, 0, errPTZUnsupported
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	stream := m.streams[name]
+	if stream == nil {
+		stream = &ptzStream{}
+		m.streams[name] = stream
+	}
+	if stream.current != nil && !stream.current.ended {
+		if stream.current.started.IsZero() {
+			// A session whose first move never arrived (a click or a cancelled drag) must not
+			// block the next drag forever. It never touched the motor.
+			stream.current.ended = true
+			stream.current.cancel()
+		} else {
+			return 0, 0, errPTZConflict
+		}
+	}
+	stream.nextSession++
+	ctx, cancel := context.WithCancel(context.Background())
+	session := &ptzSession{
+		session: stream.nextSession,
+		mode:    mode,
+		motor:   motor,
+		created: now,
+		cancel:  cancel,
+	}
+	stream.current = session
+	if m.autoRun {
+		go m.run(ctx, name, stream, session)
+	}
+	_ = now
+	return session.session, mode, nil
+}
+
+func (m *ptzManager) move(name, epoch string, session, seq uint64, direction string, now time.Time) (ptzMode, error) {
+	operation, ok := directionOperation(direction)
+	if !ok {
+		return 0, fmt.Errorf("invalid direction")
+	}
+	if epoch != m.epoch {
+		return 0, errPTZEpoch
+	}
+
+	m.mu.Lock()
+	stream := m.streams[name]
+	if stream == nil || stream.current == nil || stream.current.session != session {
+		m.mu.Unlock()
+		return 0, errPTZNoSession
+	}
+	current := stream.current
+	if current.ended || session <= stream.stoppedThrough {
+		m.mu.Unlock()
+		return 0, errPTZEnded
+	}
+	if seq <= current.lastSeq {
+		m.mu.Unlock()
+		return 0, errPTZStale
+	}
+	current.lastSeq = seq
+	directionChanged := current.direction != direction
+	current.direction = direction
+	wasActive := !current.started.IsZero()
+	if !wasActive {
+		current.started = now
+		current.expires = now.Add(m.timing.Lease)
+		current.lastStep = now
+	} else {
+		current.expires = now.Add(m.timing.Lease)
+	}
+	if directionChanged {
+		current.lastStep = now
+	}
+	mode := current.mode
+	m.mu.Unlock()
+
+	if !wasActive || directionChanged {
+		if err := m.sendStep(stream, current, operation); err != nil {
+			_ = m.end(stream, current, mode != ptzStep)
+			return mode, err
+		}
+	}
+	return mode, nil
+}
+
+func (m *ptzManager) heartbeat(name, epoch string, session, seq uint64, now time.Time) error {
+	if epoch != m.epoch {
+		return errPTZEpoch
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	stream := m.streams[name]
+	if stream == nil || stream.current == nil || stream.current.session != session {
+		return errPTZNoSession
+	}
+	current := stream.current
+	if current.ended || session <= stream.stoppedThrough {
+		return errPTZEnded
+	}
+	if seq <= current.lastSeq {
+		return errPTZStale
+	}
+	current.lastSeq = seq
+	if !current.started.IsZero() {
+		current.expires = now.Add(m.timing.Lease)
+	}
+	return nil
+}
+
+// stop ends the session and sends the stop operation for modes that need one. A stop for a
+// session the bridge has not seen yet still leaves a tombstone: the session is allocated by
+// begin, and stoppedThrough is monotonic.
+func (m *ptzManager) stop(name, epoch string, session uint64) (bool, ptzMode, error) {
+	if epoch != m.epoch {
+		return false, 0, errPTZEpoch
+	}
+	m.mu.Lock()
+	stream := m.streams[name]
+	if stream == nil {
+		m.mu.Unlock()
+		return false, ptzStep, nil
+	}
+	if session == 0 || session > stream.nextSession {
+		m.mu.Unlock()
+		return false, 0, errPTZNoSession
+	}
+	mode := ptzStep
+	current := stream.current
+	if current == nil || current.session != session {
+		if session > stream.stoppedThrough {
+			stream.stoppedThrough = session
+		}
+		m.mu.Unlock()
+		return false, mode, nil
+	}
+	mode = current.mode
+	if current.ended {
+		wait := current.stopDone
+		m.mu.Unlock()
+		if wait != nil {
+			<-wait
+		}
+		m.mu.Lock()
+		if stream.current != current || stream.lastStopSession != session || stream.lastStopErr == nil {
+			sent, err := storedStopLocked(stream, session)
+			m.mu.Unlock()
+			return sent, mode, err
+		}
+		// A repeated stop is a new attempt, not a cached failure: re-command the motor as long
+		// as this session still owns the stream. The stop barrier orders this write before a
+		// new session's first move, while a session that is no longer current is never moved.
+		if stream.stopsInFlight == 0 {
+			stream.stopBarrier = make(chan struct{})
+		}
+		stream.stopsInFlight++
+		m.mu.Unlock()
+
+		stream.stopMu.Lock()
+		stream.motorLock.Lock()
+		err := current.motor.Motor(-1001)
+		stream.motorLock.Unlock()
+		stream.stopMu.Unlock()
+
+		m.mu.Lock()
+		if stream.current == current && stream.lastStopSession == session {
+			stream.lastStopSent = err == nil
+			stream.lastStopErr = err
+		}
+		stream.stopsInFlight--
+		if stream.stopsInFlight == 0 {
+			close(stream.stopBarrier)
+			stream.stopBarrier = nil
+		}
+		m.mu.Unlock()
+
+		if err != nil {
+			return false, mode, fmt.Errorf("%w: %v", errPTZStopWrite, err)
+		}
+		return true, mode, nil
+	}
+	sendStop := mode != ptzStep && !current.started.IsZero()
+	m.mu.Unlock()
+	sent, err := m.finishSession(stream, current, sendStop)
+	if err != nil {
+		return false, mode, err
+	}
+	return sent, mode, nil
+}
+
+func storedStopLocked(stream *ptzStream, session uint64) (bool, error) {
+	if stream.lastStopSession != session {
+		return false, nil
+	}
+	if stream.lastStopErr != nil {
+		return false, fmt.Errorf("%w: %v", errPTZStopWrite, stream.lastStopErr)
+	}
+	return stream.lastStopSent, nil
+}
+
+// finishSession is the one stop path for an explicit stop and for the watchdog. The motor
+// barrier starts before m.mu is released, so a new session's first step always waits for every
+// old stop write instead of overtaking it.
+func (m *ptzManager) finishSession(stream *ptzStream, session *ptzSession, sendStop bool) (bool, error) {
+	m.mu.Lock()
+	if session.ended || stream.current != session {
+		m.mu.Unlock()
+		return false, nil
+	}
+	if sendStop {
+		if stream.stopsInFlight == 0 {
+			stream.stopBarrier = make(chan struct{})
+		}
+		stream.stopsInFlight++
+		session.stopDone = make(chan struct{})
+	}
+	session.ended = true
+	if session.session > stream.stoppedThrough {
+		stream.stoppedThrough = session.session
+	}
+	session.cancel()
+	m.mu.Unlock()
+
+	if !sendStop {
+		return false, nil
+	}
+	stream.stopMu.Lock()
+	stream.motorLock.Lock()
+	err := session.motor.Motor(-1001)
+	stream.motorLock.Unlock()
+	stream.stopMu.Unlock()
+
+	m.mu.Lock()
+	stream.lastStopSession = session.session
+	stream.lastStopSent = err == nil
+	stream.lastStopErr = err
+	stream.stopsInFlight--
+	if stream.stopsInFlight == 0 {
+		close(stream.stopBarrier)
+		stream.stopBarrier = nil
+	}
+	close(session.stopDone)
+	session.stopDone = nil
+	m.mu.Unlock()
+
+	if err != nil {
+		return false, fmt.Errorf("%w: %v", errPTZStopWrite, err)
+	}
+	return true, nil
+}
+
+func (m *ptzManager) sendStep(stream *ptzStream, session *ptzSession, operation int) error {
+	// Wait for a stop write that is already on the wire. Re-check after the wait: the barrier is
+	// the linearization point between an old stop and a new session's first move.
+	for {
+		m.mu.Lock()
+		barrier := stream.stopBarrier
+		m.mu.Unlock()
+		if barrier == nil {
+			break
+		}
+		<-barrier
+	}
+	stream.motorLock.Lock()
+	defer stream.motorLock.Unlock()
+	m.mu.Lock()
+	if session.ended || stream.current != session {
+		m.mu.Unlock()
+		return errPTZEnded
+	}
+	m.mu.Unlock()
+	return session.motor.Motor(operation)
+}
+
+func (m *ptzManager) end(stream *ptzStream, session *ptzSession, sendStop bool) error {
+	_, err := m.finishSession(stream, session, sendStop)
+	return err
+}
+
+func (m *ptzManager) run(ctx context.Context, name string, stream *ptzStream, session *ptzSession) {
+	ticker := time.NewTicker(m.timing.Tick)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-ticker.C:
+			m.tickStream(stream, session, now)
+		}
+	}
+}
+
+// tick advances every stream once. Tests call it with explicit timestamps instead of sleeping.
+func (m *ptzManager) tick(now time.Time) {
+	m.mu.Lock()
+	type entry struct {
+		stream  *ptzStream
+		session *ptzSession
+	}
+	entries := make([]entry, 0, len(m.streams))
+	for _, stream := range m.streams {
+		if stream.current != nil {
+			entries = append(entries, entry{stream: stream, session: stream.current})
+		}
+	}
+	m.mu.Unlock()
+	for _, e := range entries {
+		m.tickStream(e.stream, e.session, now)
+	}
+}
+
+func (m *ptzManager) tickStream(stream *ptzStream, session *ptzSession, now time.Time) {
+	m.mu.Lock()
+	if stream.current != session || session.ended {
+		m.mu.Unlock()
+		return
+	}
+	if session.started.IsZero() {
+		expired := now.Sub(session.created) >= m.timing.Lease
+		m.mu.Unlock()
+		if expired {
+			_, _ = m.finishSession(stream, session, false)
+		}
+		return
+	}
+	expired := !now.Before(session.expires) || now.Sub(session.started) >= m.timing.Cap
+	if expired {
+		mode := session.mode
+		m.mu.Unlock()
+		_ = m.end(stream, session, mode != ptzStep)
+		return
+	}
+	if session.mode == ptzStep && now.Sub(session.lastStep) >= m.timing.Step {
+		operation, ok := directionOperation(session.direction)
+		session.lastStep = now
+		m.mu.Unlock()
+		if ok {
+			if err := m.sendStep(stream, session, operation); err != nil {
+				_ = m.end(stream, session, false)
+			}
+		}
+		return
+	}
+	m.mu.Unlock()
+}
+
+func apiPTZ(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("X-MenuBarMijia-PTZ", "v1")
+	if r.Method != "POST" {
+		http.Error(w, "POST only", http.StatusMethodNotAllowed)
+		return
+	}
+	if !isLoopback(r.RemoteAddr) {
+		http.Error(w, "loopback only", http.StatusForbidden)
+		return
+	}
+	if r.Header.Get("Origin") != "" {
+		http.Error(w, "origin not allowed", http.StatusForbidden)
+		return
+	}
+
+	var req struct {
+		Src       string `json:"src"`
+		Action    string `json:"action"`
+		Epoch     string `json:"epoch"`
+		Session   uint64 `json:"session"`
+		Seq       uint64 `json:"seq"`
+		Direction string `json:"direction"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.Src == "" {
+		http.Error(w, "invalid request", http.StatusBadRequest)
+		return
+	}
+
+	now := time.Now()
+	switch req.Action {
+	case "begin":
+		session, mode, err := ptz.begin(req.Src, now)
+		if err != nil {
+			writePTZError(w, err)
+			return
+		}
+		writePTZJSON(w, map[string]any{
+			"ok": true, "epoch": ptz.epoch, "session": session, "mode": mode.String(),
+		})
+	case "move":
+		mode, err := ptz.move(req.Src, req.Epoch, req.Session, req.Seq, req.Direction, now)
+		if err != nil {
+			writePTZError(w, err)
+			return
+		}
+		writePTZJSON(w, map[string]any{"ok": true, "mode": mode.String()})
+	case "heartbeat":
+		if err := ptz.heartbeat(req.Src, req.Epoch, req.Session, req.Seq, now); err != nil {
+			writePTZError(w, err)
+			return
+		}
+		writePTZJSON(w, map[string]any{"ok": true})
+	case "stop":
+		sent, mode, err := ptz.stop(req.Src, req.Epoch, req.Session)
+		if err != nil && !errors.Is(err, errPTZStopWrite) {
+			writePTZError(w, err)
+			return
+		}
+		reply := map[string]any{
+			"ok": true, "mode": mode.String(), "stopSent": sent, "stopConfirmed": false,
+		}
+		if err != nil {
+			reply["stopError"] = "write_failed"
+		}
+		writePTZJSON(w, reply)
+	default:
+		http.Error(w, "invalid action", http.StatusBadRequest)
+	}
+}
+
+func writePTZJSON(w http.ResponseWriter, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+func writePTZError(w http.ResponseWriter, err error) {
+	code := http.StatusBadRequest
+	switch {
+	case errors.Is(err, errPTZConflict), errors.Is(err, errPTZEnded),
+		errors.Is(err, errPTZStale), errors.Is(err, errPTZNoSession),
+		errors.Is(err, errPTZUnsupported), errors.Is(err, errPTZNoMotor),
+		errors.Is(err, errPTZEpoch):
+		code = http.StatusConflict
+	}
+	http.Error(w, err.Error(), code)
+}
+
+func isLoopback(remoteAddr string) bool {
+	host, _, err := net.SplitHostPort(remoteAddr)
+	if err != nil {
+		host = remoteAddr
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
