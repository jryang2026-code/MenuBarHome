+// lost move.
+func (c *Conn) WriteCommandNoWait(cmd uint32, data []byte) error {
+	c.cmdMu.Lock()
+	defer c.cmdMu.Unlock()
+
+	req := marshalCmd(0, c.seqCh0, cmd, data)
+	c.seqCh0++
+	_, err := c.Conn.Write(req)
+	return err
+}
+
+// AbortWaits wakes every WriteCommand blocked on its UDP acknowledgement retry.
+func (c *Conn) AbortWaits() {
+	c.abortMu.Lock()
+	if c.abort != nil {
+		close(c.abort)
+	}
+	c.abort = make(chan struct{})
+	c.abortMu.Unlock()
+}
+
+func (c *Conn) abortChan() chan struct{} {
+	c.abortMu.Lock()
+	defer c.abortMu.Unlock()
+	if c.abort == nil {
+		c.abort = make(chan struct{})
+	}
+	return c.abort
+}
