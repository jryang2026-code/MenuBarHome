+func (f *fakeSession) SendFrameData([]byte, []byte) []byte     { return nil }
+func (f *fakeSession) RecvIOCtrl() (uint32, []byte, error)     { return 0, nil, net.ErrClosed }
+func (f *fakeSession) RecvFrameData() ([]byte, []byte, error)  { return nil, nil, net.ErrClosed }
+func (f *fakeSession) SessionRead(byte, []byte) int            { return 0 }
+func (f *fakeSession) SessionWrite(byte, []byte) error {
+	f.once.Do(func() { close(f.sent) })
+	f.mu.Lock()
+	f.writes++
+	f.mu.Unlock()
+	return nil
+}
+
+func TestTutkAbortWaitsInterruptsLostAckRetry(t *testing.T) {
+	session := &fakeSession{sent: make(chan struct{})}
+	c := &Conn{session: session}
+	done := make(chan error, 1)
+	go func() { done <- c.WriteCommand(0x112, []byte{1}) }()
+
+	<-session.sent
+	begin := time.Now()
+	c.AbortWaits()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected an aborted command error")
+		}
+		if elapsed := time.Since(begin); elapsed > 500*time.Millisecond {
+			t.Fatalf("abort waited for the retry tick: %s", elapsed)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("WriteCommand did not return after AbortWaits")
+	}
+}
+
+func TestTutkWriteCommandNoWaitDoesNotBlock(t *testing.T) {
+	session := &fakeSession{sent: make(chan struct{})}
+	c := &Conn{session: session}
+	done := make(chan error, 1)
+	go func() { done <- c.WriteCommandNoWait(0x1001, []byte{1}) }()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("WriteCommandNoWait blocked")
+	}
+}
