+
+type blockingMotor struct {
+	model       string
+	started     chan struct{}
+	release     chan struct{}
+	once        sync.Once
+	releaseOnce sync.Once
+	abortDrop   bool
+	mu          sync.Mutex
+	aborted     bool
+	ops         []int
+}
+
+func (b *blockingMotor) Motor(operation int) error {
+	if operation == 1 {
+		b.once.Do(func() { close(b.started) })
+		<-b.release
+		b.mu.Lock()
+		drop := b.abortDrop && b.aborted
+		b.mu.Unlock()
+		if drop {
+			return errors.New("aborted")
+		}
+	}
+	b.mu.Lock()
+	b.ops = append(b.ops, operation)
+	b.mu.Unlock()
+	return nil
+}
+
+func (b *blockingMotor) Abort() {
+	b.mu.Lock()
+	b.aborted = true
+	unblock := b.abortDrop
+	b.mu.Unlock()
+	if unblock && b.release != nil {
+		b.releaseOnce.Do(func() { close(b.release) })
+	}
+}
+
+func (b *blockingMotor) Model() string { return b.model }
+
