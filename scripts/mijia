    "idempotentHint": True,
    "openWorldHint": False,
}
CONTROL_NON_IDEMPOTENT_ANNOTATIONS = {
    "readOnlyHint": False,
    "destructiveHint": False,
    "idempotentHint": False,
    "openWorldHint": False,
}

