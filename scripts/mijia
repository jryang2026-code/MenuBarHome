    McpToolSpec(
        name="focus_device",
        description="在 MenuBarHome 面板中定位并展开指定设备的详情抽屉（只做界面跳转，不改变设备状态）。",
        input_schema={
            "type": "object",
            "properties": {
                "device": {"type": "string", "description": "设备名、ID 或拼音首字母"},
            },
            "required": ["device"],
            "additionalProperties": False,
        },
        annotations=READ_ONLY_ANNOTATIONS,
        handler=_mcp_focus_device,
    ),
)

MCP_TOOLS_BY_NAME: dict[str, McpToolSpec] = {spec.name: spec for spec in MCP_TOOLS}


def _jsonrpc_result(req_id: object, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def _jsonrpc_error(req_id: object, code: int, message: str) -> dict:
    return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}}


MAX_MCP_FRAME_BYTES = 4 * 1024 * 1024


def _validate_tool_arguments(spec: McpToolSpec, arguments: dict) -> None:
    allowed = set((spec.input_schema.get("properties") or {}).keys())
    unknown = sorted(set(arguments.keys()) - allowed)
    if unknown:
        allowed_list = "、".join(sorted(allowed)) or "（无参数）"
        raise CliError(f"工具 {spec.name} 不认识参数 {', '.join(unknown)}；可用参数：{allowed_list}")


def handle_mcp_message(ctx: McpContext, message: object) -> dict | None:
    """处理单条 JSON-RPC 2.0 消息；通知（无 id）返回 None。"""
    if not isinstance(message, dict) or message.get("jsonrpc") != "2.0":
        req_id = message.get("id") if isinstance(message, dict) else None
        return _jsonrpc_error(req_id, -32600, "Invalid Request: expected JSON-RPC 2.0 object")

    method = message.get("method")
    has_id = "id" in message and message.get("id") is not None
    req_id = message.get("id")
    params = message.get("params")

    if not isinstance(method, str) or not method:
        return _jsonrpc_error(req_id, -32600, "Invalid Request: missing method") if has_id else None

    if not has_id:
        return None

    if params is not None and not isinstance(params, dict):
        return _jsonrpc_error(req_id, -32602, "Invalid params: expected object")
    params = params or {}

    if method == "initialize":
        requested = str(params.get("protocolVersion") or "").strip()
        negotiated = (
            requested
            if requested in MCP_SUPPORTED_PROTOCOL_VERSIONS
            else MCP_DEFAULT_PROTOCOL_VERSION
        )
        return _jsonrpc_result(
            req_id,
            {
                "protocolVersion": negotiated,
                "capabilities": {
                    "tools": {"listChanged": False},
                    "resources": {"subscribe": False, "listChanged": False},
                },
                "serverInfo": dict(MCP_SERVER_INFO),
                "instructions": MCP_INSTRUCTIONS,
            },
        )

    if method in ("ping", "logging/setLevel"):
        return _jsonrpc_result(req_id, {})

    if method == "completion/complete":
        return _jsonrpc_result(req_id, {"completion": {"values": [], "total": 0, "hasMore": False}})

    if method == "prompts/list":
        return _jsonrpc_result(req_id, {"prompts": []})

    if method == "resources/templates/list":
        return _jsonrpc_result(req_id, {"resourceTemplates": []})

    if method == "resources/list":
        return _jsonrpc_result(
            req_id,
            {
                "resources": [
                    {
                        "uri": spec.uri,
                        "name": spec.name,
                        "description": spec.description,
                        "mimeType": spec.mime_type,
                    }
                    for spec in MCP_RESOURCES
                ]
            },
        )

    if method == "resources/read":
        uri = params.get("uri")
        if not isinstance(uri, str) or uri not in MCP_RESOURCES_BY_URI:
            return _jsonrpc_error(req_id, -32602, f"Unknown resource URI: {uri!r}")
        spec = MCP_RESOURCES_BY_URI[uri]
        try:
            snapshot = load_snapshot(ctx.path)
            payload = spec.reader(snapshot)
        except CliError as error:
            return _jsonrpc_error(req_id, -32000, str(error))
        return _jsonrpc_result(
            req_id,
            {
                "contents": [
                    {
                        "uri": spec.uri,
                        "mimeType": spec.mime_type,
                        "text": json.dumps(payload, ensure_ascii=False, indent=2),
                    }
                ]
            },
        )

    if method == "tools/list":
        return _jsonrpc_result(
            req_id,
            {
                "tools": [
                    {
                        "name": spec.name,
                        "description": spec.description,
                        "inputSchema": spec.input_schema,
                        "annotations": spec.annotations,
                    }
                    for spec in MCP_TOOLS
                ]
            },
        )

    if method == "tools/call":
        name = params.get("name")
        if not isinstance(name, str) or name not in MCP_TOOLS_BY_NAME:
            return _jsonrpc_error(req_id, -32602, f"Unknown tool: {name!r}")
        arguments = params.get("arguments")
        if arguments is None:
            arguments = {}
        if not isinstance(arguments, dict):
            return _jsonrpc_error(req_id, -32602, "Invalid params: tool arguments must be an object")
        spec = MCP_TOOLS_BY_NAME[name]
        try:
            _validate_tool_arguments(spec, arguments)
            result = spec.handler(ctx, arguments)
        except CliError as error:
            result = _tool_result(str(error), is_error=True)
        return _jsonrpc_result(req_id, result)

    return _jsonrpc_error(req_id, -32601, f"Method not found: {method}")


def _is_header_start(stripped: bytes) -> bool:
    if stripped.startswith((b"{", b"[")) or b":" not in stripped:
        return False
    name = stripped.split(b":", 1)[0].strip().lower()
    return name in (b"content-length", b"content-type")


def _read_mcp_frame(stream) -> tuple[str | None, bool]:
    """从字节流读取一条 MCP 消息，返回 (json_text, is_content_length_framed)。EOF 返回 (None, False)。"""
    while True:
        first_line = stream.readline()
        if not first_line:
            return None, False
        stripped = first_line.strip()
        if not stripped:
            continue
        if _is_header_start(stripped):
            headers: dict[bytes, bytes] = {}
            line = stripped
            while True:
                if b":" in line:
                    k, v = line.split(b":", 1)
                    headers[k.strip().lower()] = v.strip()
                next_line = stream.readline()
                if not next_line or next_line in (b"\r\n", b"\n"):
                    break
                line = next_line.strip()
            raw_len = headers.get(b"content-length")
            if raw_len is None:
                raise ValueError("Missing Content-Length header")
            try:
                content_length = int(raw_len)
            except ValueError as error:
                raise ValueError(f"Invalid Content-Length header: {raw_len!r}") from error
            if content_length <= 0 or content_length > MAX_MCP_FRAME_BYTES:
                raise ValueError(f"Out-of-bounds Content-Length: {content_length}")
            body = stream.read(content_length)
            if len(body) < content_length:
                raise ValueError(
                    f"Incomplete Content-Length frame: expected {content_length} bytes, got {len(body)}"
                )
            return body.decode("utf-8", errors="replace"), True
        return stripped.decode("utf-8", errors="replace"), False


def _write_mcp_frame(stream, payload: dict | list, *, framed: bool) -> None:
    encoded = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    if framed:
        header = f"Content-Length: {len(encoded)}\r\n\r\n".encode("ascii")
        stream.write(header + encoded)
    else:
        stream.write(encoded + b"\n")
    stream.flush()


def serve_mcp_stdio(
    ctx: McpContext,
    stdin=None,
    stdout=None,
) -> int:
    in_stream = stdin if stdin is not None else sys.stdin.buffer
    out_stream = stdout if stdout is not None else sys.stdout.buffer
    while True:
        try:
            raw_text, framed = _read_mcp_frame(in_stream)
        except ValueError as error:
            _write_mcp_frame(out_stream, _jsonrpc_error(None, -32700, f"Parse error: {error}"), framed=True)
            continue
        if raw_text is None:
            return EXIT_OK
        try:
            parsed = json.loads(raw_text)
        except json.JSONDecodeError as error:
            _write_mcp_frame(out_stream, _jsonrpc_error(None, -32700, f"Parse error: {error}"), framed=framed)
            continue

        if isinstance(parsed, list):
            if not parsed:
                _write_mcp_frame(
                    out_stream,
                    _jsonrpc_error(None, -32600, "Invalid Request: empty batch"),
                    framed=framed,
                )
                continue
            responses = [
                resp for item in parsed if (resp := handle_mcp_message(ctx, item)) is not None
            ]
            if responses:
                _write_mcp_frame(out_stream, responses, framed=framed)
            continue

        response = handle_mcp_message(ctx, parsed)
        if response is not None:
            _write_mcp_frame(out_stream, response, framed=framed)


# MARK: - CLI Argument Parser


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mijia",
        description="通过 menumijia:// 链接控制 MenuBarHome（需在设置里打开「Raycast 集成」）。",
        epilog=f"快照路径可用环境变量 {SNAPSHOT_ENV} 覆盖。",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    def common(subparser: argparse.ArgumentParser) -> argparse.ArgumentParser:
        subparser.add_argument("--snapshot", help="快照文件路径（默认读应用写出的那份）")
        subparser.add_argument("--json", action="store_true", help="输出 JSON")
        subparser.add_argument(
            "--timeout", type=float, default=DEFAULT_TIMEOUT, help=f"等待结果的秒数（默认 {DEFAULT_TIMEOUT:g}）"
        )
        subparser.add_argument("--dry-run", action="store_true", help="只打印将要打开的链接")
        subparser.add_argument("--no-wait", action="store_true", help="打开链接后不等待执行结果")
        return subparser

    listing = common(subparsers.add_parser("list", help="列出面板里可见的设备"))
    listing.add_argument("--room", help="只看某个房间")

    common(subparsers.add_parser("status", help="概览连接、场景与环境读数"))

    for cmd_name, help_text in (
        ("toggle", "翻转设备主开关"),
        ("on", "打开设备"),
        ("off", "关闭设备"),
        ("focus", "在面板中定位并展开该设备的详情抽屉"),
    ):
        sub = common(subparsers.add_parser(cmd_name, help=help_text))
        sub.add_argument("device", help="设备名、ID 或拼音首字母")

    brightness = common(subparsers.add_parser("brightness", help="设置灯具亮度百分比（0–100）"))
    brightness.add_argument("device", help="灯具名称、ID 或拼音首字母")
    brightness.add_argument("percent", help="亮度百分比（0–100，0 为关灯）")

    color_temp = common(subparsers.add_parser("color-temp", help="设置灯具色温（1000–20000K）"))
    color_temp.add_argument("device", help="灯具名称、ID 或拼音首字母")
    color_temp.add_argument("kelvin", help="色温（开尔文 K，如 2700、4000、6500）")

    temperature = common(subparsers.add_parser("temperature", help="设置温控设备目标温度（°C）"))
    temperature.add_argument("device", help="温控设备名称、ID 或拼音首字母")
    temperature.add_argument("celsius", help="目标摄氏温度（°C）")

    fan = common(subparsers.add_parser("fan", help="设置风扇或净化器风速百分比或预设档位"))
    fan.add_argument("device", help="风扇或净化器名称、ID 或拼音首字母")
    fan.add_argument("--percent", help="风速百分比（1–100）")
    fan.add_argument("--preset", help="预设档位名称")

    scene = common(subparsers.add_parser("scene", help="执行场景或内置快捷动作"))
    scene.add_argument("name", help="场景名、快捷动作名或它们对应的 ID")

    for cmd_name, help_text in (("ask", "执行一句话指令"), ("command", "同 ask")):
        sub = common(subparsers.add_parser(cmd_name, help=help_text))
        sub.add_argument("text", help="自然语言指令")

    mcp = subparsers.add_parser("mcp", help="启动基于 stdio 的本地 MCP 服务（供 Claude / Cursor 调用）")
    mcp.add_argument("--snapshot", help="快照文件路径（默认读应用写出的那份）")
    mcp.add_argument(
        "--timeout", type=float, default=DEFAULT_TIMEOUT, help=f"等待结果的秒数（默认 {DEFAULT_TIMEOUT:g}）"
    )
    return parser


def main(
    argv: list[str] | None = None,
    *,
    opener=open_url,
    now=time.monotonic,
    sleep=time.sleep,
    env: dict | None = None,
    stdin=None,
    stdout=None,
) -> int:
    args = build_parser().parse_args(argv)
    try:
        path = snapshot_path(args.snapshot, env)
        timeout = validate_timeout(args.timeout)
        if args.command == "mcp":
            ctx = McpContext(path=path, opener=opener, now=now, sleep=sleep, timeout=timeout)
            return serve_mcp_stdio(ctx, stdin=stdin, stdout=stdout)

        snapshot = load_snapshot(path)
        if args.command == "list":
            return command_list(snapshot, args.room, args.json)
        if args.command == "status":
            return command_status(snapshot, args.json)

        def dispatch(route: str, params: list[tuple[str, str]]) -> int:
            return send(
                snapshot,
                path,
                route,
                params,
                opener=opener,
                now=now,
                sleep=sleep,
                timeout=timeout,
                dry_run=args.dry_run,
                wait=not args.no_wait,
                as_json=args.json,
            )

        if args.command == "toggle":
            device = match_device(snapshot, args.device)
            _require_toggleable(device)
            return dispatch("toggle", [("device", device["id"])])
        if args.command in ("on", "off"):
            device = match_device(snapshot, args.device)
            _require_toggleable(device)
            return dispatch("power", [("device", device["id"]), ("on", "true" if args.command == "on" else "false")])
        if args.command == "brightness":
            device = match_device(snapshot, args.device)
            percent = validate_brightness(device, args.percent)
            return dispatch("brightness", [("device", device["id"]), ("percent", str(percent))])
        if args.command == "color-temp":
            device = match_device(snapshot, args.device)
            kelvin = validate_color_temp(device, args.kelvin)
            return dispatch("color-temp", [("device", device["id"]), ("kelvin", str(kelvin))])
        if args.command == "temperature":
            device = match_device(snapshot, args.device)
            celsius = validate_temperature(device, args.celsius)
            return dispatch("temperature", [("device", device["id"]), ("celsius", _number(celsius))])
        if args.command == "fan":
            device = match_device(snapshot, args.device)
            return dispatch("fan", validate_fan(device, args.percent, args.preset))
        if args.command == "focus":
            device = match_device(snapshot, args.device)
            return dispatch("focus", [("device", device["id"])])
        if args.command == "scene":
            kind, item = match_scene(snapshot, args.name)
            name = f"quick:{item['id']}" if kind == "quick" else str(item["id"])
            return dispatch("scene", [("name", name)])
        if args.command in ("ask", "command"):
            text = args.text.strip()
            if not text:
                raise CliError("指令不能为空")
            if len(text) > MAX_ASK_LENGTH:
                raise CliError(f"指令长度不能超过 {MAX_ASK_LENGTH} 个字符")
            return dispatch("ask", [("text", text)])
        raise CliError(f"不认识的命令：{args.command}")
    except CliError as error:
        print(f"mijia: {error}", file=sys.stderr)
        return EXIT_LOCAL_ERROR


if __name__ == "__main__":
    sys.exit(main())
