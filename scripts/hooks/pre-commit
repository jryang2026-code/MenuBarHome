#!/usr/bin/env bash
# Local commit gate: `scripts/check.sh --lint-only` (secret scan, mechanical lints, script
# self-tests). The test suites and the snapshot comparison do not run on every commit: run
# `bash scripts/check.sh` once before opening or updating a PR (CI skips the snapshot comparison,
# so that run is the only one that compares pixels). MMB_HOOK_FULL=1 runs the full gate here.
#
# A commit only needs the verdict, so the run goes to a log file: success prints the summary
# lines, including the long-file list, failure prints the failing cases plus the log's tail and
# keeps the log. MMB_HOOK_VERBOSE=1 streams everything.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
# git exports GIT_DIR and GIT_INDEX_FILE to hooks. The gate's self-tests build scratch repos with
# `git -C "$tmp"`, which still obeys those variables, so without this they write `user.name` into
# the shared repo config and stage scratch files into the commit being made. check.sh only reads
# the worktree, so it runs without them; the unstaged-snapshot check above keeps the real index.
CHECK=(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR
    bash "$ROOT_DIR/scripts/check.sh")
if [ "${MMB_HOOK_FULL:-0}" != "1" ]; then
    CHECK+=(--lint-only)
fi

bash "$ROOT_DIR/scripts/gate_report.sh" unstaged-snapshots

if [ "${MMB_HOOK_VERBOSE:-0}" = "1" ]; then
    exec "${CHECK[@]}"
fi

LOG="$(mktemp "${TMPDIR:-/tmp}/mmb-pre-commit.XXXXXX")"
echo "🔒 提交前检查运行中（完整输出写入 ${LOG}）..."
status=0
"${CHECK[@]}" >"$LOG" 2>&1 || status=$?

if [ "$status" -eq 0 ]; then
    bash "$ROOT_DIR/scripts/gate_report.sh" hook-success "$LOG" || true
    rm -f "$LOG"
    if [ "${MMB_HOOK_FULL:-0}" != "1" ]; then
        echo "ℹ️  提交钩子只跑快速 lint；推送前请按需跑 bash scripts/check.sh --changed（UI 改动需含快照验证）。"
    fi
    exit 0
fi

echo "❌ 提交前检查失败（退出码 ${status}），完整日志保留在：${LOG}"
grep -E '✘|✖|❌|error:|^not ok ' "$LOG" | head -40 || true
echo "--- 日志末尾 ---"
tail -n 20 "$LOG"
exit "$status"
