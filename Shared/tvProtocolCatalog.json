    {
      "id": "redmi_ddc_display",
      "displayNames": {
        "zh": "Redmi 显示器 DDC/CI",
        "en": "Redmi display over DDC/CI"
      },
      "kind": "display",
      "vendors": ["Redmi", "Xiaomi"],
      "models": ["Redmi G27U", "Redmi A27U", "Redmi G27"],
      "transport": {
        "family": "ddcCi",
        "channels": ["iokitI2c"],
        "ports": [],
        "discovery": ["edid", "iokitServiceMatch"]
      },
      "pairing": {
        "required": false,
        "method": "none",
        "inputs": [],
        "notes": ["识别到受支持的显示器后直接开放已回读的 VCP 能力。"]
      },
      "capabilities": {
        "power": false,
        "volume": true,
        "mute": true,
        "inputSource": true,
        "directionalKeys": false,
        "nowPlaying": false,
        "supportsNowPlayingSeek": false,
        "wakeOnLan": false
      },
      "commands": ["display.brightness.set", "volume.set", "mute.set", "input.select"],
      "limitations": [
        "纯显示器没有播放状态或媒体元数据。",
        "电源 VCP 码由 forbiddenVcpCodes 明确禁用，不接受批量透传。",
        "仅开放显示器报告为可读写的 VCP 码。"
      ],
      "metadata": {
        "coldBootSupported": false,
        "vcpCodes": [
          { "code": "0x10", "name": "brightness", "writable": true },
          {
            "code": "0x60",
            "name": "inputSource",
            "writable": true,
            "values": { "DP1": 15, "DP2": 16, "HDMI1": 17, "HDMI2": 18, "USBC": 27 }
          },
          { "code": "0x62", "name": "volume", "writable": true },
          { "code": "0x8D", "name": "mute", "writable": true }
        ],
        "forbiddenVcpCodes": ["0xD6"],
        "macOsBridgeNote": "AppleDCPMCDP29XX -> 0xB7 桥片暴露 DDC/CI，按 IOKit 服务路径识别，不按型号名猜测。"
      }
    },
