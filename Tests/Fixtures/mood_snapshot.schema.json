{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local mood snapshots",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "moods"],
  "properties": {
    "version": { "const": 1 },
    "moods": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "createdAt", "targets"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deviceId", "name", "sourceScope", "entityId"],
              "properties": {
                "deviceId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "sourceScope": {
                  "type": "string",
                  "pattern": "^(ha:|mi:|demo$)",
                  "description": "Source connection scope. HA uses the canonical server URL, Mi the account ID. Match this and entityId before replaying."
                },
                "entityId": { "type": "string", "minLength": 1 },
                "power": { "type": "boolean" },
                "brightness": { "type": "integer", "minimum": 1, "maximum": 100 },
                "colorTemperature": { "type": "integer", "minimum": 1 },
                "coverPosition": { "type": "integer", "minimum": 0, "maximum": 100 },
                "targetTemperature": { "type": "number", "description": "Device target temperature in degrees Celsius." },
                "hvacMode": { "type": "string", "minLength": 1 }
              },
              "minProperties": 5
            }
          }
        }
      }
    }
  }
}
