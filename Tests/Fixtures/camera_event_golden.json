{
  "schemaVersion": 1,
  "retentionSeconds": 604800,
  "maxEvents": 500,
  "stillWallLimit": 4,
  "stillRefreshCooldownSeconds": 60,
  "allowedKinds": ["doorbell", "motion", "person", "package"],
