        "timestamp": "2026-11-24T10:00:00Z"
      }
    },
    {
      "reason": "url_in_camera_id",
      "record": {
        "id": "bad-2",
        "cameraID": "rtsp://admin:secret@192.0.2.10/live",
        "kind": "doorbell",
        "timestamp": "2026-11-24T10:00:00Z"
      }
    },
    {
      "reason": "unknown_kind",
      "record": {
        "id": "bad-3",
        "cameraID": "cam-front-door",
        "kind": "laser",
        "timestamp": "2026-11-24T10:00:00Z"
      }
    },
    {
      "reason": "invalid_timestamp",
      "record": {
        "id": "bad-4",
        "cameraID": "cam-front-door",
        "kind": "motion",
        "timestamp": "not-a-date"
      }
    },
    {
      "reason": "non_object_entry",
      "record": "corrupt-line"
    }
  ],
  "unsafeSnapshotFilenames": [
    "",
    "../secret.jpeg",
    "..\\secret.jpeg",
    "/tmp/snapshot-1.jpeg",
    "C:\\Users\\test\\snapshot-1.jpeg",
    "rtsp://user:pass@192.0.2.10/stream",
    "http://192.0.2.10/api/frame.jpeg?token=abc",
    "snapshot-1.jpeg?token=abc",
    "snapshot-1.png",
    "random.txt"
  ],
  "stillWallSelectionCase": {
    "visibleCameraIds": ["cam-c", "cam-d", "cam-e", "cam-f", "cam-g"],
    "eventfulCameraIds": ["cam-e", "cam-d"],
    "limit": 4,
    "expectedOrder": ["cam-d", "cam-e", "cam-c", "cam-f"]
  }
}
