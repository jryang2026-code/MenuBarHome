  "metadataCases": [
    {
      "label": "missing rollout defaults to nil",
      "json": {
        "tag_name": "v1.5.0",
        "body": "Bug fixes"
      },
      "expectedRolloutPercentage": null
    },
    {
      "label": "top-level snake_case rollout_percentage",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": 25,
        "body": "Bug fixes"
      },
      "expectedRolloutPercentage": 25
    },
    {
      "label": "top-level camelCase rolloutPercentage",
      "json": {
        "tag_name": "v1.5.0",
        "rolloutPercentage": 40
      },
      "expectedRolloutPercentage": 40
    },
    {
      "label": "body html comment with rollout_percentage",
      "json": {
        "tag_name": "v1.5.0",
        "body": "Notes\n<!-- rollout_percentage: 15 -->"
      },
      "expectedRolloutPercentage": 15
    },
    {
      "label": "body html comment with short rollout and percent sign",
      "json": {
        "tag_name": "v1.5.0",
        "body": "<!-- ROLLOUT: 30% -->\nRelease notes"
      },
      "expectedRolloutPercentage": 30
    },
    {
      "label": "top-level takes precedence over body comment",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": 60,
        "body": "<!-- rollout: 10 -->"
      },
      "expectedRolloutPercentage": 60
    },
    {
      "label": "top-level numeric zero pauses rollout",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": 0,
        "body": "Paused release"
      },
      "expectedRolloutPercentage": 0
    },
    {
      "label": "top-level numeric one enables 1 percent rollout",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": 1,
        "body": "Canary release"
      },
      "expectedRolloutPercentage": 1
    },
    {
      "label": "boolean rollout_percentage is ignored",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": true,
        "body": "No directive"
      },
      "expectedRolloutPercentage": null
    },
    {
      "label": "false boolean rollout_percentage is ignored",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": false,
        "body": "No directive"
      },
      "expectedRolloutPercentage": null
    },
    {
      "label": "out-of-range percentage clamps to 0..100",
      "json": {
        "tag_name": "v1.5.0",
        "rollout_percentage": 150
      },
      "expectedRolloutPercentage": 100
    }
  ]
}
