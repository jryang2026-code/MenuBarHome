{
  "manifestVersion": 1,
  "adapterId": "com.example.bad-secret-readback",
  "name": {
    "zh": "密钥回显适配器",
    "en": "Secret Readback Adapter"
  },
  "version": "0.1.0",
  "hostApi": "^0.1.0",
  "runtime": {
    "type": "binary",
    "entry": "bin/adapter",
    "arch": ["arm64"]
  },
  "platforms": ["macos"],
  "auth": [
    {
      "id": "lan-key",
      "type": "apiKey",
      "label": {
        "zh": "局域网密钥",
        "en": "LAN Key"
      },
      "prompts": [
        {
          "key": "lanKey",
          "inputType": "secret",
          "writeOnly": false
        }
      ]
    }
  ],
  "capabilities": {
    "readOnly": true,
    "deviceKinds": ["sensor"]
  },
  "permissions": {
    "network": {
      "internet": [],
      "lan": true
    }
  },
  "ui": {
    "configSchema": {
      "type": "object",
      "properties": {
        "lanKey": {
          "type": "string",
          "writeOnly": false
        }
      }
    }
  }
}
